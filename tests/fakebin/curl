#!/bin/sh
# Fake `curl` for the test suite: never touches the network.
#   Driver downloads: writes $FAKE_STATE/download (or "not the real file"),
#   and $FAKE_STATE/download_usbnet for a usbnet.ko
#   to the file given with -o.  curl_404 makes URLs containing its text 404.
#   Releases (https://releases.test/...): serves $FAKE_STATE/rel/NAME.
#   Speed test (URLs with __down or __up): answers -w with a fixed transfer
#   of 25 MB in 0.5 s per request (400 Mbit/s per stream), a 12 ms connect,
#   and a "colo: TST" header for -D -.  $FAKE_STATE/speed_time (seconds per
#   transfer) and $FAKE_STATE/colo change those.  An upload reports the
#   bytes it really got on stdin, taking that long per 25 MB, or
#   $FAKE_STATE/up_rate bytes/s: one that can't finish within --max-time
#   is cut off with no answer (000), like a slow upload link.
#   -w gets "bytes total setup code", with 10 ms of connect and TLS setup.
printf 'curl %s\n' "$*" >> "$FAKE_STATE/curl.log"
out="" fmt="" url="" dump="" maxt=999
while [ $# -gt 0 ]; do
    case "$1" in
        -o) shift; out=$1 ;;
        -w) shift; fmt=$1 ;;
        -D) shift; dump=$1 ;;
        --max-time) shift; maxt=$1 ;;
        http*) url=$1 ;;
    esac
    shift
done
# Simulate a TLS failure (curl exit 35) when asked
[ -e "$FAKE_STATE/curl_fail" ] && { echo "curl: (35) SSL connect error" >&2; exit 35; }
# Or a 404 for URLs containing the text in curl_404 (a repository that's gone)
if [ -s "$FAKE_STATE/curl_404" ]; then
    case "$url" in *"$(cat "$FAKE_STATE/curl_404")"*) echo "curl: (22) The requested URL returned error: 404" >&2; exit 22 ;; esac
fi
case "$url" in
    *__down*|*__up*)
        [ "$dump" = - ] && printf 'HTTP/2 200\r\ncolo: %s\r\n\r\n' "$(cat "$FAKE_STATE/colo" 2>/dev/null || echo TST)"
        # An upload reports the bytes it really got on stdin
        sent=25000000
        case "$url" in *__up*) sent=$(wc -c | tr -d ' ') ;; esac
        sleep 0.2
        per=$(cat "$FAKE_STATE/speed_time" 2>/dev/null || echo 0.500)
        case "$url" in
            *__up*) took=$(awk -v s="$sent" -v p="$per" -v r="$(cat "$FAKE_STATE/up_rate" 2>/dev/null)" 'BEGIN { printf "%.3f", (r > 0) ? s / r : s * p / 25000000 }') ;;
            *) took=$per ;;
        esac
        case "$fmt" in
            *time_connect*) printf '0.013 0.001\n' ;;
            # $FAKE_STATE/speed_429: Cloudflare limiting tests run back to back
            *size_*)
                if [ -e "$FAKE_STATE/speed_429" ]; then printf '13 0.010 0.005 429'
                elif awk -v t="$took" -v m="$maxt" 'BEGIN { exit !(t > m) }'; then
                    # Cut off by --max-time before the server answered
                    printf '%s %s 0.010 000' "$(awk -v s="$sent" -v t="$took" -v m="$maxt" 'BEGIN { printf "%.0f", s * m / t }')" "$maxt"
                    exit 28
                else printf '%s %s 0.010 200' "$sent" "$(awk -v t="$took" 'BEGIN { printf "%.3f", t + 0.010 }')"; fi ;;
        esac
        exit 0 ;;
esac
[ -n "$out" ] || exit 2
# Releases (LGU2E_RELEASES points here): files from $FAKE_STATE/rel, by name
case "$url" in
    https://releases.test/*)
        f=$FAKE_STATE/rel/${url##*/}
        [ -f "$f" ] || { echo "curl: (22) The requested URL returned error: 404" >&2; exit 22; }
        cat "$f" > "$out"
        exit 0 ;;
esac
# usbnet.ko, which some drivers bring along: $FAKE_STATE/download_usbnet
case "$url" in
    */usbnet.ko) if [ -f "$FAKE_STATE/download_usbnet" ]; then cat "$FAKE_STATE/download_usbnet" > "$out"; else echo "not the real file" > "$out"; fi; exit 0 ;;
esac
if [ -f "$FAKE_STATE/download" ]; then cat "$FAKE_STATE/download" > "$out"; else echo "not the real file" > "$out"; fi
