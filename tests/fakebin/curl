#!/bin/sh
# Fake `curl` for the test suite: never touches the network.
#   Driver downloads: writes $FAKE_STATE/download (or "not the real file")
#   to the file given with -o.  curl_404 makes URLs containing its text 404.
#   Releases (https://releases.test/...): serves $FAKE_STATE/rel/NAME.
#   Speed test (URLs with __down or __up): answers -w with a fixed transfer
#   of 25 MB in 0.5 s per request (400 Mbit/s per stream), a 12 ms connect,
#   and a "colo: TST" header for -D -.
printf 'curl %s\n' "$*" >> "$FAKE_STATE/curl.log"
out="" fmt="" url="" dump=""
while [ $# -gt 0 ]; do
    case "$1" in
        -o) shift; out=$1 ;;
        -w) shift; fmt=$1 ;;
        -D) shift; dump=$1 ;;
        http*) url=$1 ;;
    esac
    shift
done
# Simulate a TLS failure (curl exit 35) when asked
[ -e "$FAKE_STATE/curl_fail" ] && { echo "curl: (35) SSL connect error" >&2; exit 35; }
# Or a 404 for URLs containing the text in curl_404 (a repository that's gone)
if [ -s "$FAKE_STATE/curl_404" ]; then
    case "$url" in *"$(cat "$FAKE_STATE/curl_404")"*) echo "curl: (22) The requested URL returned error: 404" >&2; exit 22 ;; esac
fi
case "$url" in
    *__down*|*__up*)
        [ "$dump" = - ] && printf 'HTTP/2 200\r\ncolo: TST\r\n\r\n'
        case "$url" in *__up*) cat > /dev/null ;; esac
        sleep 0.2
        case "$fmt" in
            *time_connect*) printf '0.013 0.001\n' ;;
            *size_*) printf '25000000 0.500' ;;
        esac
        exit 0 ;;
esac
[ -n "$out" ] || exit 2
# Releases (LGU2E_RELEASES points here): files from $FAKE_STATE/rel, by name
case "$url" in
    https://releases.test/*)
        f=$FAKE_STATE/rel/${url##*/}
        [ -f "$f" ] || { echo "curl: (22) The requested URL returned error: 404" >&2; exit 22; }
        cat "$f" > "$out"
        exit 0 ;;
esac
if [ -f "$FAKE_STATE/download" ]; then cat "$FAKE_STATE/download" > "$out"; else echo "not the real file" > "$out"; fi
