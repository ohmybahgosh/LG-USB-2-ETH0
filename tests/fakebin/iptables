#!/bin/sh
# Fake `iptables` for the test suite: keeps OUTPUT rules, one per line, in
# $FAKE_STATE/iptables.  Handles -C (check), -I (insert), -D (delete) and -L
# (list).
printf 'iptables %s\n' "$*" >> "$FAKE_STATE/iptables.log"
f=$FAKE_STATE/iptables
touch "$f"
# Like iptables 1.8.7: -h lists --wait, and -w [seconds] waits for the lock.
# $FAKE_STATE/iptables_locked: another tool holds the lock, so a call
# without -w fails with exit 4
# $FAKE_STATE/no_filter: a kernel without ip_tables (no filter table)
if [ -e "$FAKE_STATE/no_filter" ] && [ "$1" != -h ]; then
    echo "iptables v1.6.2: can't initialize iptables table \`filter': Table does not exist (do you need to insmod?)" >&2
    exit 3
fi
if [ "$1" = -h ]; then echo '  --wait -w [seconds]	maximum wait to acquire xtables lock before give up'; exit 0; fi
if [ "$1" = -w ]; then
    shift
    case "$1" in [0-9]*) shift ;; esac
    printf 'waited\n' >> "$FAKE_STATE/iptables.waits"
elif [ -e "$FAKE_STATE/iptables_locked" ]; then
    echo "Another app is currently holding the xtables lock." >&2
    exit 4
fi
op=$1
shift
rule="$*"
case "$op" in
    -C) grep -qxF -- "$rule" "$f" ;;
    -I) printf '%s\n' "$rule" > "$f.new"; cat "$f" >> "$f.new"; mv "$f.new" "$f" ;;
    -D) n=$(grep -nxF -- "$rule" "$f" | head -n 1 | cut -d: -f1)
        [ -n "$n" ] || exit 1
        sed "${n}d" "$f" > "$f.new"; mv "$f.new" "$f" ;;
    # -L OUTPUT -n -v -x: the rules with packet counts, each DROP rule's
    # count from $FAKE_STATE/iptables_hits (default 0)
    -L) echo "Chain OUTPUT (policy ACCEPT 0 packets, 0 bytes)"
        echo "    pkts      bytes target     prot opt in     out     source               destination"
        sed -n 's/^OUTPUT -d \([^ ]*\) -j DROP$/\1/p' "$f" | while read -r _ip; do
            printf '%8s %10s DROP       all  --  *      *       0.0.0.0/0            %s\n' "$(cat "$FAKE_STATE/iptables_hits" 2>/dev/null || echo 0)" 0 "$_ip"
        done ;;
    *) exit 0 ;;
esac
